<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <rect width="512" height="512" rx="115" fill="#ffffff" />
  
  <!-- Rising Bar Chart (Emerald, Teal, Blue) -->
  <rect x="172" y="158" width="54" height="90" rx="4" fill="#08996f" />
  <rect x="242" y="122" width="54" height="126" rx="4" fill="#179c99" />
  <rect x="312" y="84" width="54" height="164" rx="4" fill="#1077e6" />

  <!-- Wallet Base (Deep Navy) -->
  <path d="M118 214 h36 v18 h-22 a8 8 0 0 0 0 16 h234 a38 38 0 0 1 38 38 v126 a38 38 0 0 1 -38 38 h-218 a38 38 0 0 1 -38 -38 v-150 a38 38 0 0 1 38 -38 Z" fill="#072144" />

  <!-- Teal Mid Wave -->
  <path d="M236 248 h130 a38 38 0 0 1 38 38 v126 a38 38 0 0 1 -38 38 h-32 c-52 -24 -88 -94 -98 -202 Z" fill="#0e747d" />

  <!-- Center Arch & Emerald Right Wave -->
