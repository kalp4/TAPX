  tabAnimClass,
  themePref,
  setThemePref,
  settingsSection,
  setSettingsSection,
  personalApiUrl,
  copyToClipboard,
  copiedField,
  handleOneTapShortcut,
  settings,
  handleRegenerateToken,
  categories,
  currentMonthSpendByCat,
