          ctx.beginPath();
          ctx.arc(358, 330, 13, 0, Math.PI * 2);
          ctx.fill();
          ctx.lineWidth = 6;
          ctx.strokeStyle = '#111110';
          ctx.stroke();

          ctx.restore();

          var pngDataUrl = c.toDataURL('image/png');
          var iconLink = document.getElementById('ios-touch-icon');
          if (iconLink) iconLink.setAttribute('href', pngDataUrl);
        } catch (e) {}
      })();
