          className={`pointer-events-auto relative grid grid-cols-4 items-center w-full max-w-[388px] h-[60px] p-[5px] rounded-full touch-none transition-transform duration-300 ios-spring ${
            lensBulge ? 'scale-[1.02]' : 'scale-100'
