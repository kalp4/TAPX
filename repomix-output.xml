}

// 7. Bouncy elastic rewind pop for Undo (+ light pulse)
export function playUndo() {
  triggerHaptic('light');
  if (!soundEnabled) return;
  const engine = getAudioEngine();
  if (!engine) return;

  try {
    synthTone(engine, {
      freqStart: 220,
      freqEnd: 520,
      duration: 0.065,
      delay: 0,
      volume: 0.13,
      type: 'sine',
      attack: 0.003
    });
    synthTone(engine, {
      freqStart: 520,
      freqEnd: 780,
      duration: 0.095,
      delay: 0.055,
      volume: 0.12,
      type: 'triangle',
      attack: 0.003,
      lowpassFreq: 2600
    });
  } catch {}
}

// 8. Playful muted cartoon woodblock double-knock for validation errors (+ gentle double-nudge)
export function playError() {
  triggerHaptic('error');
  if (!soundEnabled) return;
  const engine = getAudioEngine();
  if (!engine) return;

  try {
    synthTone(engine, {
      freqStart: 210,
      freqEnd: 135,
      duration: 0.065,
      delay: 0,
      volume: 0.16,
      type: 'triangle',
      attack: 0.002,
      lowpassFreq: 900
    });
    synthTone(engine, {
      freqStart: 165,
      freqEnd: 105,
      duration: 0.085,
      delay: 0.08,
      volume: 0.17,
      type: 'triangle',
      attack: 0.002,
      lowpassFreq: 800
    });
  } catch {}
}

// 9. Soft airy lift when opening bottom sheets (no vibration)
export function playModalOpen() {
  if (!soundEnabled) return;
  const engine = getAudioEngine();
  if (!engine) return;

  try {
    synthNoise(engine, {
      duration: 0.04,
      volume: 0.04,
      filterType: 'bandpass',
      freqStart: 600,
      freqEnd: 1500,
      q: 1.0
    });
    synthTone(engine, {
      freqStart: 240,
      freqEnd: 410,
      duration: 0.06,
      volume: 0.08,
      type: 'sine',
      attack: 0.005
    });
  } catch {}
}

// 10. Crisp magnetic double-tick for Copy & CSV Export (+ ultra-light tick)
export function playCopy() {
  triggerHaptic('tick');
  if (!soundEnabled) return;
  const engine = getAudioEngine();
  if (!engine) return;

  try {
    synthNoise(engine, {
      duration: 0.004,
      volume: 0.07,
      filterType: 'highpass',
      freqStart: 2600
    });
    synthTone(engine, {
      freqStart: 980,
      duration: 0.035,
      delay: 0,
      volume: 0.09,
      type: 'sine',
      attack: 0.002
    });
    synthTone(engine, {
      freqStart: 1480,
      duration: 0.06,
      delay: 0.04,
      volume: 0.1,
      type: 'sine',
      attack: 0.002
    });
  } catch {}
}
