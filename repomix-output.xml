    showToast('Transaction updated!');

    if (!String(oldTx.id).startsWith('temp-')) {
      await supabase
        .from('transactions')
        .update({
          amount: newAmt,
          note: cleanNote,
          wallet_id: nextWalletId,
          to_wallet_id: nextToWalletId,
          category_id: nextCategoryId,
          created_at: nextCreatedAt
        })
        .eq('id', oldTx.id);

