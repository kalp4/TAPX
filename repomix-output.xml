              playSuccess('save');
              fetchUserData(session.user.id);
              showToast('Synced!');
            }}
            handleLogout={handleLogout}
          />
        )}
      </main>

      {showWalletModal && (
        <WalletModal
          ui={ui}
          editingWalletId={editingWalletId}
          newWalletName={newWalletName}
          setNewWalletName={setNewWalletName}
          newWalletType={newWalletType}
