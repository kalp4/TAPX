                }}
                className={`min-w-[172px] p-3.5 rounded-2xl flex flex-col justify-between cursor-pointer transition-all shrink-0 relative overflow-hidden key-press ${
                  isFiltered ? ui.walletCardHero : `${ui.card} wallet-sheen`
