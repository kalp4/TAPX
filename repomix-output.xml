        />
      )}

      {/* CHUNKY CARTOON DOCK BAR (Flush at bottom: 10px) */}
      <div
        className="fixed left-0 right-0 z-40 flex justify-center pointer-events-none px-4"
        style={{
          bottom: '10px'
        }}
      >
        <nav
