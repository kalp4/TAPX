                const { category: c, cleanNote } = resolveTxCategory(tx);
                const catAccent =
                  tx.type === 'transfer'
                    ? '#F4B942'
                    : tx.type === 'income'
                    ? '#52B788'
                    : getCategoryAccentColor(c, idx);

