    const fromWalletObj = wallets.find((w) => w.id === fromId);
    const toWalletObj = destId ? wallets.find((w) => w.id === destId) : null;

    const expectedFromBalance =
      currentType === 'income'
        ? Number(fromWalletObj?.balance || 0) + numericAmount
        : Number(fromWalletObj?.balance || 0) - numericAmount;

