          onClose={resetWalletModal}
        />
      )}

      {showCategoryModal && (
        <CategoryModal
          ui={ui}
          editingCatId={editingCatId}
          newCatName={newCatName}
          setNewCatName={setNewCatName}
          newCatType={newCatType}
          setNewCatType={setNewCatType}
